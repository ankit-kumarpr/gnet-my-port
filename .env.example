# Email Service (Optional for local dev, logs to console if omitted)
RESEND_API_KEY=re_your_api_key_here

# Redis Rate Limiting (Optional for local dev)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Cloudflare Turnstile Bot Defense (Optional for local dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# ==============================================================================
# PHASE 7: GRANDEUR CMS & ADMIN CONFIGURATION
# ==============================================================================

# 1. MongoDB Atlas Connection String
# e.g. mongodb+srv://username:password@cluster0.abcde.mongodb.net/grandeur-portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/grandeur-portfolio?retryWrites=true&w=majority

# 2. Admin Authentication & Session Security
# Generate a strong 64-character secret using: openssl rand -base64 32
JWT_SECRET=grandeur_super_secure_jwt_secret_change_me_in_production
DEFAULT_ADMIN_EMAIL=admin@grandeurnet.com
DEFAULT_ADMIN_PASSWORD=GrandeurAdmin2026!
DEFAULT_ADMIN_NAME=Grandeur Administrator

# 3. Cloudinary Asset Management (Signed Direct Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
